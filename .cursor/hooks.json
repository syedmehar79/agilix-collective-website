{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/start-dev-server.js",
        "timeout": 30
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/mark-deploy.js"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/deploy-on-stop.js",
        "timeout": 300
      }
    ]
  }
}
